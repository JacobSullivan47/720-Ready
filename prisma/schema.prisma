generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth v5 — database session strategy)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // set for credentials-based accounts; null for OAuth-only
  createdAt     DateTime  @default(now())
  marketingOptIn Boolean  @default(false) // consent to be emailed updates/donation asks — off unless explicitly checked at signup
  tutorUnlimited Boolean  @default(false) // admin-granted exemption from TUTOR_MAX_MESSAGES_PER_DAY

  accounts Account[]
  sessions Session[]

  cardProgress     CardProgress[]
  questionAttempts QuestionAttempt[]
  mockExams        MockExam[]
  bookmarks        Bookmark[]
  studyLogs        StudyLog[]
  tutorConversations TutorConversation[]
  tutorMessages      TutorMessage[]
  exerciseAttempts   ExerciseAttempt[]
  overviewViews      OverviewView[]
  practiceSessions   PracticeSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------------------------------------------------------------------------
// Content taxonomy
// ---------------------------------------------------------------------------

enum DomainKey {
  AGENTIC_ARCHITECTURE
  TOOL_DESIGN_MCP
  CLAUDE_CODE_WORKFLOWS
  PROMPT_ENGINEERING
  CONTEXT_MANAGEMENT
}

enum ScenarioKey {
  CUSTOMER_SUPPORT_AGENT
  CODE_GENERATION_CLAUDE_CODE
  MULTI_AGENT_RESEARCH
  DEVELOPER_PRODUCTIVITY_TOOLS
  CLAUDE_CODE_CI_CD
  STRUCTURED_DATA_EXTRACTION
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Domain/Scenario carry only the minimal relational anchor. The rich
// overview text (summary, key knowledge, anti-patterns, etc.) lives solely
// in src/content/domains.ts and src/content/scenarios.ts — a single source
// of truth, imported directly wherever it's needed instead of duplicated
// into the database.
model Domain {
  key       DomainKey @id
  name      String
  weightPct Int
  sortOrder Int

  flashcards Flashcard[]
  questions  Question[]
}

model Scenario {
  key       ScenarioKey @id
  name      String
  sortOrder Int

  flashcards Flashcard[]
  questions  Question[]
}

// ---------------------------------------------------------------------------
// Flashcards (also power the Glossary — every flashcard is a glossary entry)
// ---------------------------------------------------------------------------

model Flashcard {
  id          String      @id @default(cuid())
  domainKey   DomainKey
  scenarioKey ScenarioKey?
  term        String
  definition  String      @db.Text
  example     String      @db.Text
  difficulty  Difficulty  @default(MEDIUM)
  sortOrder   Int         @default(0)

  domain   Domain    @relation(fields: [domainKey], references: [key])
  scenario Scenario? @relation(fields: [scenarioKey], references: [key])

  progress  CardProgress[]
  bookmarks Bookmark[]

  @@index([domainKey])
  @@index([scenarioKey])
}

// SM-2 spaced-repetition state, one row per (user, card)
model CardProgress {
  id            String   @id @default(cuid())
  userId        String
  cardId        String
  easeFactor    Float    @default(2.5)
  intervalDays  Int      @default(0)
  repetitions   Int      @default(0)
  dueAt         DateTime @default(now())
  lastRating    Int? // 0 = "still learning", 1 = "knew it" (mapped to SM-2 quality internally)
  lapses        Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
}

// ---------------------------------------------------------------------------
// Practice questions
// ---------------------------------------------------------------------------

enum QuestionType {
  SINGLE
  MULTI
}

model Question {
  id             String       @id @default(cuid())
  domainKey      DomainKey
  scenarioKey    ScenarioKey?
  type           QuestionType @default(SINGLE)
  prompt         String       @db.Text
  options        Json // string[]
  correctIndexes Json // number[]
  explanation    String       @db.Text
  eli10          String       @db.Text
  difficulty     Difficulty   @default(MEDIUM)
  sortOrder      Int          @default(0)

  domain   Domain    @relation(fields: [domainKey], references: [key])
  scenario Scenario? @relation(fields: [scenarioKey], references: [key])

  attempts        QuestionAttempt[]
  bookmarks       Bookmark[]
  mockExamEntries MockExamQuestion[]

  @@index([domainKey])
  @@index([scenarioKey])
}

enum AttemptMode {
  PRACTICE
  MOCK
}

model QuestionAttempt {
  id              String      @id @default(cuid())
  userId          String
  questionId      String
  mode            AttemptMode
  mockExamId      String?
  selectedIndexes Json // number[]
  isCorrect       Boolean
  createdAt       DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  mockExam   MockExam?   @relation(fields: [mockExamId], references: [id], onDelete: SetNull)

  @@index([userId, questionId])
  @@index([userId, mode])
}

// ---------------------------------------------------------------------------
// Mock exams
// ---------------------------------------------------------------------------

enum MockExamStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model MockExam {
  id            String         @id @default(cuid())
  userId        String
  status        MockExamStatus @default(IN_PROGRESS)
  scenarioKeys  Json // ScenarioKey[] (the 4 drawn scenarios)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  timeLimitSec  Int            @default(7200)
  scaledScore   Int?
  passed        Boolean?
  domainBreakdown Json? // { [DomainKey]: { correct, total } }
  answers       Json           @default("{}") // { [questionId]: number[] } — saved incrementally while in progress
  currentIndex  Int            @default(0) // last question the user was viewing, for resume
  remainingSec  Int            @default(7200) // countdown, frozen while the tab is hidden — not derived from startedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions MockExamQuestion[]
  attempts  QuestionAttempt[]

  @@index([userId, startedAt])
}

// Snapshot of the 60 questions assigned to a given mock exam, in fixed order
model MockExamQuestion {
  id         String   @id @default(cuid())
  mockExamId String
  questionId String
  order      Int

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([mockExamId, order])
}

// Untimed Practice session state, for resuming after navigating away.
// questionIds is the fixed shuffled order decided at session start (Practice
// question order isn't reconstructible from filters alone, same as mock
// exams). No per-question answer replay is needed on resume — Practice has
// no "back" navigation, so currentIndex + correctCount is always enough.
model PracticeSession {
  id               String        @id @default(cuid())
  userId           String
  questionIds      Json // string[], fixed order
  currentIndex     Int           @default(0)
  correctCount     Int           @default(0)
  domainFilter     DomainKey?
  scenarioFilter   ScenarioKey?
  difficultyFilter Difficulty?
  completedAt      DateTime?
  startedAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ---------------------------------------------------------------------------
// Bookmarks, streaks
// ---------------------------------------------------------------------------

enum BookmarkItemType {
  FLASHCARD
  QUESTION
}

model Bookmark {
  id         String           @id @default(cuid())
  userId     String
  itemType   BookmarkItemType
  cardId     String?
  questionId String?
  createdAt  DateTime         @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Flashcard? @relation(fields: [cardId], references: [id], onDelete: Cascade)
  question Question?  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@unique([userId, questionId])
}

// One row per user per calendar day with any study activity — powers streaks.
model StudyLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------------------------------------------------------------------------
// Interactive exercises + overview read-tracking
// ---------------------------------------------------------------------------

enum ExerciseType {
  CONFIG_BUILDER
  ANTI_PATTERN_SPOTTER
  SEQUENCING
}

// One row per attempt at one exercise item (an anti-pattern scenario, a
// sequencing puzzle, or the single config-builder exercise). itemId is a
// stable string key (see EXERCISE_ITEM_DOMAIN in src/content/exercises.ts);
// domainKey is resolved server-side from that same map, never trusted
// directly from the client.
model ExerciseAttempt {
  id           String       @id @default(cuid())
  userId       String
  exerciseType ExerciseType
  itemId       String
  domainKey    DomainKey
  isCorrect    Boolean
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domainKey])
  @@index([userId, itemId])
}

enum OverviewItemType {
  DOMAIN
  SCENARIO
}

// Tracks that a user has opened a domain/scenario overview page at least
// once. Purely a "read" checklist, not a graded/mastery signal — overview
// pages are reference material with no right/wrong to score.
model OverviewView {
  id          String           @id @default(cuid())
  userId      String
  itemType    OverviewItemType
  domainKey   DomainKey?
  scenarioKey ScenarioKey?
  viewedAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domainKey])
  @@unique([userId, scenarioKey])
}

// ---------------------------------------------------------------------------
// AI Tutor chat (rate-limited, requires an account)
// ---------------------------------------------------------------------------

model TutorConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  // The focus key (e.g. "question:abc123") this conversation was started
  // for, or null for a general/nav-bar conversation. A new focus that
  // differs from the most recent conversation's focus starts a fresh one
  // instead of appending to unrelated history — keeps token usage down and
  // keeps old, unrelated Q&A from bleeding into a new question's context.
  focus     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, updatedAt])
}

enum TutorRole {
  USER
  ASSISTANT
}

model TutorMessage {
  id             String    @id @default(cuid())
  conversationId String
  userId         String // denormalized for fast daily rate-limit counting
  role           TutorRole
  content        String    @db.Text
  createdAt      DateTime  @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role, createdAt])
}
