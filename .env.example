# Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/720ready"

# Random secret used to sign sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Only needed for the AI Study Tutor feature; everything else works without it.
ANTHROPIC_API_KEY=""

# Optional: enables "Continue with Google". Set NEXT_PUBLIC_GOOGLE_ENABLED="true"
# alongside these if you configure them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Comma-separated list of account email(s) allowed to access /admin.
# Unset means no one can access it (fails closed), not "everyone".
ADMIN_EMAILS=""

# Public site URL, used for metadata (Open Graph, sitemap, robots.txt).
# Set this to your real production domain when deploying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
